; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gez (1453) — Godot PoC"
config/description="Phase 8.5 Step 2 proof of concept: 1453 political map powered by GezCore GameSession via SwiftGodot."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.16, 0.25, 0.33, 1)
