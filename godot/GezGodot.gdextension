[configuration]
entry_symbol = "gez_godot_entry"
compatibility_minimum = "4.7"

[libraries]
macos.debug = "res://bin/libGezGodot.dylib"
macos.release = "res://bin/libGezGodot.dylib"

[dependencies]
macos.debug = {
    "res://bin/SwiftGodotRuntime.framework": ""
}
macos.release = {
    "res://bin/SwiftGodotRuntime.framework": ""
}
